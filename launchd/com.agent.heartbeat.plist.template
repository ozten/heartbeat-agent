<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Copy to ~/Library/LaunchAgents/ and replace AGENT_NAME and PROJECT_DIR -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.AGENT_NAME.heartbeat</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>PROJECT_DIR/heartbeat/heartbeat.sh</string>
  </array>

  <!-- Run every 30 minutes -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <key>StandardOutPath</key>
  <string>PROJECT_DIR/logs/heartbeat-stdout.log</string>

  <key>StandardErrorPath</key>
  <string>PROJECT_DIR/logs/heartbeat-stderr.log</string>

  <key>WorkingDirectory</key>
  <string>PROJECT_DIR</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/YOURUSERNAME/.local/bin</string>
    <key>HOME</key>
    <string>/Users/YOURUSERNAME</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
