#!/usr/bin/env node
// bin/enqueue — Intent queue management
// No secrets. No execution. Just queue CRUD.
// Safe to call from heartbeat sessions that process untrusted external content.
//
// Usage:
//   enqueue add --action <type> --target <value> --rationale "..." [--context "..."]
//   enqueue list [--status pending|ignored|done|all]
//   enqueue ignore --id <id> --reason "..."
//   enqueue done --id <id>

const fs = require('fs');
const path = require('path');
const crypto = require('crypto');

const PROJECT_DIR = path.join(__dirname, '..');
const QUEUE_FILE = path.join(PROJECT_DIR, 'logs', 'intent-queue.json');

const VALID_ACTIONS = [
  'moltbook:post',
  'moltbook:comment',
  'moltbook:follow',
  'moltbook:reply',
  'github:push',
  'github:pr',
  'code:write',
  'code:run',
  'code:test',
];

function loadQueue() {
  if (!fs.existsSync(QUEUE_FILE)) return [];
  try {
    return JSON.parse(fs.readFileSync(QUEUE_FILE, 'utf8'));
  } catch {
    return [];
  }
}

function saveQueue(queue) {
  fs.mkdirSync(path.dirname(QUEUE_FILE), { recursive: true });
  fs.writeFileSync(QUEUE_FILE, JSON.stringify(queue, null, 2) + '\n');
}

function parseArgs(argv) {
  const args = {};
  let i = 0;
  while (i < argv.length) {
    if (argv[i].startsWith('--')) {
      const key = argv[i].slice(2);
      const val = argv[i + 1] && !argv[i + 1].startsWith('--') ? argv[i + 1] : true;
      args[key] = val;
      i += val === true ? 1 : 2;
    } else {
      i++;
    }
  }
  return args;
}

function cmd_add(args) {
  if (!args.action) { console.error('--action required'); process.exit(1); }
  if (!args.rationale) { console.error('--rationale required'); process.exit(1); }
  if (!VALID_ACTIONS.includes(args.action)) {
    console.error(`Invalid action "${args.action}". Valid: ${VALID_ACTIONS.join(', ')}`);
    process.exit(1);
  }

  const intent = {
    id: crypto.randomUUID(),
    created: new Date().toISOString(),
    action: args.action,
    target: args.target || null,
    rationale: args.rationale,
    context: args.context || null,
    status: 'pending',
  };

  const queue = loadQueue();
  queue.push(intent);
  saveQueue(queue);

  console.log(JSON.stringify({ ok: true, id: intent.id }));
}

function cmd_list(args) {
  const status = args.status || 'pending';
  const queue = loadQueue();
  const filtered = status === 'all' ? queue : queue.filter(i => i.status === status);
  console.log(JSON.stringify(filtered, null, 2));
}

function cmd_ignore(args) {
  if (!args.id) { console.error('--id required'); process.exit(1); }
  if (!args.reason) { console.error('--reason required'); process.exit(1); }

  const queue = loadQueue();
  const intent = queue.find(i => i.id === args.id);
  if (!intent) { console.error(`Intent ${args.id} not found`); process.exit(1); }
  if (intent.status !== 'pending') {
    console.error(`Intent ${args.id} is already ${intent.status}`);
    process.exit(1);
  }

  intent.status = 'ignored';
  intent.ignored_at = new Date().toISOString();
  intent.ignore_reason = args.reason;
  saveQueue(queue);

  console.log(JSON.stringify({ ok: true, id: args.id }));
}

function cmd_done(args) {
  if (!args.id) { console.error('--id required'); process.exit(1); }

  const queue = loadQueue();
  const intent = queue.find(i => i.id === args.id);
  if (!intent) { console.error(`Intent ${args.id} not found`); process.exit(1); }

  intent.status = 'done';
  intent.done_at = new Date().toISOString();
  saveQueue(queue);

  console.log(JSON.stringify({ ok: true, id: args.id }));
}

const [,, subcmd, ...rest] = process.argv;
const args = parseArgs(rest);

switch (subcmd) {
  case 'add':    cmd_add(args);    break;
  case 'list':   cmd_list(args);   break;
  case 'ignore': cmd_ignore(args); break;
  case 'done':   cmd_done(args);   break;
  default:
    console.error('Usage: enqueue <add|list|ignore|done> [options]');
    process.exit(1);
}
